<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- Launcher icon: a bowl with a tick for steam, on an ink tile; this is the tick. -->
    <color name="ic_launcher_foreground">#FF2FBF8A</color>
    <color name="ic_launcher_background">#FF121214</color>

    <!-- Tints the notification small icon and app name; same as the accent. -->
    <color name="notification_accent">#FFF2663A</color>

    <!-- Window background: the canvas colour (night override in values-night).
         The splash stays light in both themes. -->
    <color name="launcher_background">#FFF4F4F7</color>
    <color name="splash_background">#FFF4F4F7</color>
    <bool name="light_system_bars">true</bool>
</resources>
