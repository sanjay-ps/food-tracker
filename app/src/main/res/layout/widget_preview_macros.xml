<?xml version="1.0" encoding="utf-8"?>
<!--
  Each chip is a FrameLayout: primaryContainer background + a left-aligned
  partial-width tinted overlay (battery fill) + the text content on top.
  Mirrors the live MacrosWidget.MacroChip layout.

  RemoteViews-compatible — uses FrameLayout / LinearLayout / TextView only.
  Spacers expressed as `layout_marginStart` rather than <Space> (not in the
  @RemoteView allowlist; would make initialLayout render blank).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_preview_bg_surface"
    android:padding="12dp"
    android:gravity="center_vertical">

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/widget_preview_chip_carbs_base">

        <!-- Battery fill — left ~50%, intensified carbs hue. -->
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:background="@drawable/widget_preview_chip_carbs" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Carbs"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/widget_on_primary_container" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom"
                android:layout_marginTop="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="180"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_on_primary_container" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="g"
                    android:textSize="10sp"
                    android:textColor="@color/widget_on_primary_container"
                    android:layout_marginStart="2dp"
                    android:paddingBottom="2dp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/widget_preview_chip_protein_base"
        android:layout_marginStart="8dp">

        <FrameLayout
            android:layout_width="32dp"
            android:layout_height="match_parent"
            android:background="@drawable/widget_preview_chip_protein" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Protein"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/widget_on_primary_container" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom"
                android:layout_marginTop="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="84"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_on_primary_container" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="g"
                    android:textSize="10sp"
                    android:textColor="@color/widget_on_primary_container"
                    android:layout_marginStart="2dp"
                    android:paddingBottom="2dp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/widget_preview_chip_fat_base"
        android:layout_marginStart="8dp">

        <FrameLayout
            android:layout_width="24dp"
            android:layout_height="match_parent"
            android:background="@drawable/widget_preview_chip_fat" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fat"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/widget_on_primary_container" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom"
                android:layout_marginTop="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="56"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_on_primary_container" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="g"
                    android:textSize="10sp"
                    android:textColor="@color/widget_on_primary_container"
                    android:layout_marginStart="2dp"
                    android:paddingBottom="2dp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
